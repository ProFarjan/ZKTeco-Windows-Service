{
    "devices": [
        {
            "ip": "45.125.220.224",
            "port": 4370,
            "name": "HOSPITAL DEVICE 1",
            "enabled": true
        }
    ],
    "sync_interval": 300,
    "max_retry_attempts": 3,
    "retry_delay": 5,
    "clear_device_after_sync": false,
    "api": {
        "enabled": true,
        "endpoint": "http://localhost/hospital/api/attendance/push",
        "method": "POST",
        "timeout": 30,
        "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer YOUR_API_TOKEN_HERE",
            "X-API-Key": "your-secret-key"
        },
        "batch_size": 100,
        "retry_on_failure": true,
        "save_failed_requests": true,
        "custom_params": {
            "hospital_id": "1"
        },
        "field_mapping": {
            "uid": "staff_id",
            "id": "staff_id",
            "user_id": "staff_id",
            "timestamp": "date",
            "state": "auth_method",
            "state_name": "auth_method_name",
            "type": "attendance_type",
            "type_name": "attendance_type_name",
            "device_name": "device_identifier",
            "synced_at": "sync_timestamp"
        },
        "include_fields": [],
        "exclude_fields": []
    },
    "database": {
        "enabled": false,
        "driver": "mysql",
        "host": "localhost",
        "port": 3306,
        "name": "attendance_db",
        "user": "root",
        "password": "",
        "charset": "utf8mb4"
    },
    "logging": {
        "enabled": true,
        "level": "INFO",
        "file": "logs/service.log",
        "max_size_mb": 10,
        "keep_files": 7
    }
}
